# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist/

# misc
.DS_Store
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks
*.keystore
*.db
*.sqlite
*.sqlite3
*.dump
*.backup

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Keep local environment files out of Git
.env*
!.env.example
/secrets/
/credentials/
credentials.*
secrets.*
*.credentials
*.secret
*.token
service-account*.json
/backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
